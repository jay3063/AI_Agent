[MASTER]
# CLAUDE.md 구현 지침 및 .claude/skills/tdd/references/naming-convention.md 를 CI에서
# 실제로 강제하기 위한 설정. 이 파일의 규칙을 바꾸면 그 문서도 함께 갱신한다.

[BASIC]
# 함수/변수/매개변수명은 3글자 이상 + lowerCamelCase 를 사용한다.
function-rgx=[a-z][a-zA-Z0-9]{2,}$
variable-rgx=[a-z][a-zA-Z0-9]{2,}$
argument-rgx=[a-z][a-zA-Z0-9]{2,}$
method-rgx=[a-z][a-zA-Z0-9]{2,}$
attr-rgx=[a-z][a-zA-Z0-9]{2,}$

[SIMILARITIES]
# 중복 코드 허용치(CLAUDE.md: 7라인까지 허용) — 8라인 이상만 위반으로 보고한다.
min-similarity-lines=8
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
